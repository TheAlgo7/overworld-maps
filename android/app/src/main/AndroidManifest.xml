<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Driving with the phone locked in a pocket: Samsung's battery saver doesn't put the app to
         sleep mid-drive (Settings > Phone locked, see LockedPhone). ACCESS_BACKGROUND_LOCATION is
         the next step if that isn't enough; it needs Play's location declaration first. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Ending a trip from its notification, for this app alone (see SafeForegroundServiceManager). -->
    <permission
        android:name="${applicationId}.permission.END_TRIP"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.END_TRIP" />

    <!-- Android Auto: a navigation app that draws its own map. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <application
        android:name=".OverworldApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Overworld">

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="2" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- The launcher icon is one of the aliases below, not this activity (see AppIcons). -->
            <!-- A place shared from Google Maps (Share > Overworld) or any app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Addresses and map links opened "with Overworld". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
                <data android:scheme="google.navigation" />
            </intent-filter>
        </activity>

        <!-- The launcher icons, one per world (tools/make_icon.py). Exactly one is enabled; AppIcons
             switches them when the world or Settings > Display > App icon changes. GTA V's is on to
             begin with because a first install opens on GTA V. -->
        <activity-alias
            android:name=".IconGta5"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gta5"
            android:roundIcon="@mipmap/ic_launcher_gta5"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRdr2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rdr2"
            android:roundIcon="@mipmap/ic_launcher_rdr2"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGta6"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gta6"
            android:roundIcon="@mipmap/ic_launcher_gta6"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGta6Macca"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gta6_macca"
            android:roundIcon="@mipmap/ic_launcher_gta6_macca"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.stadiamaps.ferrostar.core.service.FerrostarForegroundService"
            android:foregroundServiceType="location" />

        <!-- Report a problem: the report's files, readable by the email app the tester picks. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_paths" />
        </provider>

        <!-- The parked car's time-limit reminders (Notices.scheduleParking). -->
        <receiver
            android:name=".notify.ParkingAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".car.OverworldCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <!-- The map on the instrument cluster, between the dials, in cars that have one (Car App API 6+). -->
                <category android:name="androidx.car.app.category.FEATURE_CLUSTER" />
            </intent-filter>
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
