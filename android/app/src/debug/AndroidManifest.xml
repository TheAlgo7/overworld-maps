<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb start a simulated trip for testing the car screen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugDriveReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.thealgothrim.overworld.DEBUG_DRIVE" />
                <action android:name="com.thealgothrim.overworld.DEBUG_STOP" />
                <action android:name="com.thealgothrim.overworld.DEBUG_STATE" />
                <action android:name="com.thealgothrim.overworld.DEBUG_CHIME" />
                <action android:name="com.thealgothrim.overworld.DEBUG_CAMERA" />
                <action android:name="com.thealgothrim.overworld.DEBUG_FREEDRIVE" />
                <action android:name="com.thealgothrim.overworld.DEBUG_VDFPS" />
                <action android:name="com.thealgothrim.overworld.DEBUG_SEARCH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
